{
  "name": "say-it",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Say It! — a kids' PWA for practising numbers and letters out loud in English, French and Arabic.",
  "scripts": {
    "start": "python3 tools/serve.py 8080",
    "test": "node tests/match.test.mjs",
    "test:browser": "google-chrome --headless --disable-gpu --no-sandbox --virtual-time-budget=60000 --dump-dom http://localhost:8080/tests/browser.test.html",
    "icons": "python3 tools/make-icons.py"
  }
}
